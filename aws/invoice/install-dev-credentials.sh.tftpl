set -eu
export AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_EC2_METADATA_V1_DISABLED=true
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE AWS_ROLE_ARN AWS_WEB_IDENTITY_TOKEN_FILE AWS_CONTAINER_CREDENTIALS_RELATIVE_URI AWS_CONTAINER_CREDENTIALS_FULL_URI

identity=$(aws sts get-caller-identity --region '${region}' --query Arn --output text --no-cli-pager)
case "$identity" in
  'arn:aws:sts::${account_id}:assumed-role/${host_role_name}/'i-*) ;;
  *) echo 'Expected the TerraHorse dev EC2 instance role' >&2; exit 1 ;;
esac

umask 077
staging=$(mktemp -d)
trap 'rm -rf -- "$staging"' EXIT

cat > "$staging/refresh" <<'TERRAHORSE_REFRESH'
${refresh_script}
TERRAHORSE_REFRESH

cat > "$staging/service" <<'TERRAHORSE_SERVICE'
[Unit]
Description=Refresh TerraHorse dev invoice S3 credentials
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Group=1000
RuntimeDirectory=terrahorse-invoice
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=45
Environment=AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_EC2_METADATA_V1_DISABLED=true
UnsetEnvironment=AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE AWS_ROLE_ARN AWS_WEB_IDENTITY_TOKEN_FILE AWS_CONTAINER_CREDENTIALS_RELATIVE_URI AWS_CONTAINER_CREDENTIALS_FULL_URI
ExecStart=/usr/local/sbin/terrahorse-refresh-invoice-credentials ${role_arn} ${region}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TERRAHORSE_SERVICE

cat > "$staging/timer" <<'TERRAHORSE_TIMER'
[Unit]
Description=Rotate TerraHorse dev invoice S3 credentials

[Timer]
OnBootSec=30s
OnUnitActiveSec=15min
AccuracySec=10s

[Install]
WantedBy=timers.target
TERRAHORSE_TIMER

install -o root -g root -m 0755 "$staging/refresh" /usr/local/sbin/terrahorse-refresh-invoice-credentials
install -o root -g root -m 0644 "$staging/service" /etc/systemd/system/terrahorse-invoice-credentials.service
install -o root -g root -m 0644 "$staging/timer" /etc/systemd/system/terrahorse-invoice-credentials.timer
systemctl daemon-reload
systemctl enable --now terrahorse-invoice-credentials.timer
systemctl start terrahorse-invoice-credentials.service
